### Register a new user
POST {{baseUrl}}/api/auth/register/
Content-Type: application/json

{
    "username": "alisher",
    "email": "alisher@example.com",
    "password": "password123"
}

### Login
POST {{baseUrl}}/api/v1/staff/auth/login/
Content-Type: application/json

{
    "email": "admin@a.com",
    "password": "admin"
}

### Get Current User Info
GET {{baseUrl}}/api/auth/me/
Authorization: Bearer {{accessToken}}

### Refresh Access Token
POST {{baseUrl}}/api/auth/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}
### Get list of contacts
GET {{baseUrl}}//api/v1/contacts/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get list of contact tags
GET {{baseUrl}}//api/v1/contacts/tags
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get list of todos
GET {{baseUrl}}/api/todos/?search=django
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Post new todo
POST {{baseUrl}}/api/todos/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "title": "Learn Django2"
}
### Post new todo
POST {{baseUrl}}/api/todos/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "title": "Learn React"
}
### Post new todo
POST {{baseUrl}}/api/todos/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "title": " "
}



### Post update todo
PATCH {{baseUrl}}/api/todos/1/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "completed": true
}

### Delete update todo
DELETE {{baseUrl}}/api/todos/1/
Content-Type: application/json
Authorization: Bearer {{accessToken}}
